// Leuchtturm CloudKit schema (container iCloud.de.timschaller.leuchtturm).
// Generated from CloudSchema.swift; SchemaTests checks that both match.
// Import into Development: xcrun cktool import-schema --team-id TW877YHM7Q
//   --container-id iCloud.de.timschaller.leuchtturm --environment development --file ios/CloudKit/schema.ckdb
// Then deploy to Production in the CloudKit console.

DEFINE SCHEMA

    RECORD TYPE Circle (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        "epoch" INT64,
        "meta" BYTES,
        "sig" BYTES,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE History (
        "___createTime" TIMESTAMP,
