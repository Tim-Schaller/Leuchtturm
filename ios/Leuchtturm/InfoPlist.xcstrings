{
  "sourceLanguage": "de",
  "strings": {
    "NSLocationWhenInUseUsageDescription": {
      "comment": "Privacy - usage description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "Leuchtturm zeigt deinen Standort den Kreisen, die du auswählst. Er wird auf deinem iPhone verschlüsselt, bevor er es verlässt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leuchtturm shows your location to the circles you choose. It is encrypted on your iPhone before it leaves it."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription": {
      "comment": "Privacy - usage description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "Damit deine Kreise dich auch sehen, wenn die App geschlossen ist, braucht Leuchtturm den Standort im Hintergrund. Er wird auf deinem iPhone verschlüsselt, bevor er es verlässt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So your circles see you even when the app is closed, Leuchtturm needs your location in the background. It is encrypted on your iPhone before it leaves it."
          }
        }
      }
    },
    "NSMotionUsageDescription": {
      "comment": "Privacy - usage description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "Leuchtturm erkennt mit Bewegungsdaten, wann du fährst, um Akku zu sparen und deine Geschwindigkeit zu zeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leuchtturm uses motion data to recognize when you are driving, to save battery and to show your speed."
          }
        }
      }
    }
  },
  "version": "1.0"
}
