    "Teilt für eine Weile nur die ungefähre Gegend.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shares only the rough area for a while."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte solo la zona aproximada durante un rato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne partage qu'une zone approximative pendant un moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condivide per un po' solo la zona approssimativa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deelt een tijdje alleen de globale omgeving."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przez jakiś czas udostępnia tylko przybliżoną okolicę."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir süreliğine yalnızca yaklaşık bölgeyi paylaşır."
          }
        }
      }
    },
    "Teilt gerade nur eine ungefähre Gegend (ca. %lld km).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Currently shares only a rough area (about %lld km)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora solo comparte una zona aproximada (aprox. %lld km)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne partage actuellement qu'une zone approximative (env. %lld km)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento condivide solo una zona approssimativa (circa %lld km)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deelt nu alleen een globale omgeving (ca. %lld km)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udostępnia teraz tylko przybliżoną okolicę (ok. %lld km)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu an yalnızca kabaca bir bölgeyi paylaşıyor (yaklaşık %lld km)."
          }
        }
      }
    },
