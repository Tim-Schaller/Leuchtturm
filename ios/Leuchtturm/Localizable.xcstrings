    "Spielt durch, dass die Person diesen Link bekommt und damit beitritt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays through the person receiving this link and joining with it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Simula que la persona recibe este enlace y se une con él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Simule la réception de ce lien par la personne et son arrivée dans le phare."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Simula che la persona riceva questo link e si unisca con esso."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Speelt na dat de persoon deze link krijgt en daarmee lid wordt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Symuluje, że ta osoba dostaje ten link i dzięki niemu dołącza."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişinin bu bağlantıyı alıp onunla katılmasını canlandırır."
          }
        }
      }
    },
    "Spätestens %@ da, sonst wird dein Leuchtturm benachrichtigt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrive by %@, or your lighthouse is alerted"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llegada a las %@ como tarde; si no, se avisa a tu faro"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sois là avant %@, sinon ton phare est prévenu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrivo entro le %@, altrimenti il tuo faro viene avvisato"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uiterlijk %@ aangekomen, anders krijgt je vuurtoren een melding"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bądź na miejscu najpóźniej o %@, inaczej twoja latarnia dostanie powiadomienie"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En geç %@ orada ol, yoksa fenerine haber verilir"
          }
        }
      }
    },
