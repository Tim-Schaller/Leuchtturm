    "Nur heute": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today only"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo hoy"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aujourd'hui seulement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo oggi"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen vandaag"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko dzisiaj"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bugün"
          }
        }
      }
    },
    "Nur in Test-Builds. Die Simulation nutzt weder iCloud noch die echten Schlüssel dieses Geräts, deine echten Daten bleiben unberührt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test builds only. The simulation uses neither iCloud nor this device's real keys; your real data stays untouched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo en versiones de prueba. La simulación no usa ni iCloud ni las claves reales de este dispositivo; tus datos reales quedan intactos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement dans les versions de test. La simulation n'utilise ni iCloud ni les vraies clés de cet appareil ; tes vraies données restent intactes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo nelle build di test. La simulazione non usa né iCloud né le chiavi reali di questo dispositivo: i tuoi dati reali restano intatti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen in testbuilds. De simulatie gebruikt geen iCloud en ook niet de echte sleutels van dit apparaat; je echte gegevens blijven onaangeroerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko w wersjach testowych. Symulacja nie używa ani iCloud, ani prawdziwych kluczy tego urządzenia; twoje prawdziwe dane pozostają nietknięte."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca test sürümlerinde. Simülasyon ne iCloud’u ne de bu aygıtın gerçek anahtarlarını kullanır; gerçek verilerine dokunulmaz."
          }
        }
      }
    },
    "Nur in Test-Builds: eine Simulation mit erfundenen Personen. Nichts geht an iCloud.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test builds only: a simulation with made-up people. Nothing goes to iCloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo en versiones de prueba: una simulación con personas ficticias. Nada se envía a iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement dans les versions de test : une simulation avec des personnes fictives. Rien ne part vers iCloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo nelle build di test: una simulazione con persone inventate. Niente va su iCloud."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen in testbuilds: een simulatie met verzonnen personen. Er gaat niets naar iCloud."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko w wersjach testowych: symulacja ze zmyślonymi osobami. Nic nie trafia do iCloud."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca test sürümlerinde: hayali kişilerle bir simülasyon. iCloud’a hiçbir şey gitmez."
          }
        }
      }
    },
    "Nur solange die App läuft": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only while the app is running"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo con la app abierta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement quand l'app est ouverte"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo mentre l'app è aperta"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen zolang de app actief is"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko gdy aplikacja działa"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca uygulama çalışırken"
          }
        }
      }
    },
    "Nur von Leuten, die „Fahrten teilen“ eingeschaltet haben.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only from people who turned on “Share trips”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo de quienes tienen activado «Compartir trayectos»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement des personnes ayant activé « Partager les trajets »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo da chi ha attivato “Condividi tragitti”."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen van mensen die ‘Deel ritten’ hebben aangezet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko od osób, które włączyły „Udostępniaj przejazdy”."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca “Sürüşleri paylaş” seçeneğini açmış olanlardan."
          }
        }
      }
    },
    "Nur wer „Schritte teilen“ eingeschaltet hat (Daten aus Health).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only people who turned on “Share steps” (data from Health)."
          }
        },
        "es": {
