    "Sagt deinem Leuchtturm, wo du gerade bist.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tells your lighthouse where you are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dice a tu faro dónde estás ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique à ton phare où tu es en ce moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dice al tuo faro dove ti trovi adesso."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertelt je vuurtoren waar je nu bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Informuje twoją latarnię, gdzie teraz jesteś."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenerine şu an nerede olduğunu söyler."
          }
        }
      }
    },
    "Sagt, wo jemand aus deinem Leuchtturm gerade ist.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Says where someone from your lighthouse is right now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dice dónde está ahora alguien de tu faro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique où se trouve en ce moment une personne de ton phare."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dice dove si trova adesso qualcuno del tuo faro."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertelt waar iemand uit je vuurtoren nu is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mówi, gdzie teraz jest ktoś z twojej latarni."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenerindeki birinin şu an nerede olduğunu söyler."
          }
        }
      }
    },
    "Sanft gefahren: Serie ohne starkes Bremsen": {
      "localizations": {
