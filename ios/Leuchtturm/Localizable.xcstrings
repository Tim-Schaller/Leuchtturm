    "Ich! Bin eh unterwegs.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Me! I'm out anyway."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Yo! Total, ya estoy fuera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moi ! Je sors de toute façon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Io! Tanto sono già fuori."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik! Ben toch al onderweg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja! I tak jestem w drodze."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ben! Zaten dışarıdayım."
          }
        }
      }
    },
    "Ihr seht euch dann nicht mehr, auch euer Chat ist weg. In gemeinsamen Leuchttürmen bleibt %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You will no longer see each other, and your chat is gone. %@ stays in lighthouses you share."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejaréis de veros y vuestro chat desaparece. %@ sigue en los faros que compartís."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne vous verrez plus et votre discussion disparaît. %@ reste dans vos phares communs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non vi vedrete più e la chat sparisce. %@ resta nei fari che condividete."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jullie zien elkaar dan niet meer en jullie chat is weg. In gedeelde vuurtorens blijft %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie będziecie się już widzieć, a wasz czat zniknie. W wspólnych latarniach zostaje: %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Artık birbirinizi görmezsiniz, sohbetiniz de silinir. Ortak fenerlerde kalır: %@."
          }
        }
      }
    },
    "Im Nebel teilst du keinen genauen Ort. Beende den Nebel zuerst, um einzuchecken.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In fog you don't share an exact location. End the fog first to check in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la niebla no compartes una ubicación exacta. Desactiva primero la Niebla para hacer check-in."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans le brouillard, tu ne partages pas de position exacte. Arrête d'abord le brouillard pour faire un check-in."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella nebbia non condividi una posizione esatta. Termina prima la Nebbia per fare check-in."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In de mist deel je geen exacte locatie. Stop eerst de mist om in te checken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "We mgle nie udostępniasz dokładnej lokalizacji. Najpierw wyłącz mgłę, żeby się zameldować."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siste tam konum paylaşmazsın. Check-in yapmak için önce Sis’i kapat."
          }
        }
      }
    },
