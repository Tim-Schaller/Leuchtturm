    "Entfernt die Fahrt für alle, sie zählt dann nicht für deine Punkte.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes the trip for everyone; it no longer counts for your score."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita el trayecto para todos; ya no cuenta para tus puntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retire le trajet pour tout le monde ; il ne compte alors plus pour tes points."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove il tragitto per tutti; non conta più per i tuoi punti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert de rit voor iedereen; hij telt dan niet mee voor je punten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa przejazd dla wszystkich; nie liczy się on wtedy do twoich punktów."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürüşü herkes için kaldırır; artık puanına sayılmaz."
          }
        }
      }
    },
