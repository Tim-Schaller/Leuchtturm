    "Auf diesem Gerät fehlt noch der Schlüssel für den Leuchtturm. Der Besitzer muss die App einmal öffnen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device does not have the lighthouse's key yet. The owner needs to open the app once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A este dispositivo aún le falta la clave del faro. El propietario tiene que abrir la app una vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil n'a pas encore la clé du phare. Le propriétaire doit ouvrir l'app une fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su questo dispositivo manca ancora la chiave del faro. Il proprietario deve aprire l'app una volta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op dit apparaat ontbreekt nog de sleutel voor de vuurtoren. De eigenaar moet de app één keer openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tym urządzeniu brakuje jeszcze klucza do latarni. Właściciel musi raz otworzyć aplikację."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu aygıtta fenerin anahtarı henüz yok. Sahibin uygulamayı bir kez açması gerekiyor."
          }
        }
      }
    },
