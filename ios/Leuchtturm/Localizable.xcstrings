          }
        }
      }
    },
    "Mittel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Medium"
          }
        }
      }
    },
    "Möglicher Unfall erkannt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Possible crash detected"
          }
        }
      }
    },
    "Nach dem Beitritt sehen die Mitglieder deinen Namen und deinen Standort, Ende-zu-Ende-verschlüsselt. Das Teilen kannst du in den Einstellungen jederzeit pausieren.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After joining, members see your name and location, end-to-end encrypted. You can pause sharing in Settings at any time."
          }
        }
      }
    },
    "Nachricht": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Message"
          }
        }
      }
    },
    "Nachrichten": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages"
          }
        }
      }
    },
    "Name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name"
          }
        }
      }
    },
    "Name speichern": {
