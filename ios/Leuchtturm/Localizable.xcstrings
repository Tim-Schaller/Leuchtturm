    "Apple Karten bekommt dabei diesen Ort. In Leuchtturm selbst sieht Apple die Standorte nicht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Maps receives this place. Inside Leuchtturm, Apple does not see locations."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ello, Mapas de Apple recibe este lugar. Dentro de Leuchtturm, Apple no ve las ubicaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plans reçoit alors ce lieu. Dans Leuchtturm même, Apple ne voit pas les positions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappe di Apple riceve questo luogo. All'interno di Leuchtturm, Apple non vede le posizioni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Kaarten krijgt daarbij deze plek. In Leuchtturm zelf ziet Apple de locaties niet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapy Apple otrzymują przy tym to miejsce. W samej aplikacji Leuchtturm Apple nie widzi lokalizacji."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Harita bu yeri alır. Leuchtturm’un kendisinde ise Apple konumları görmez."
          }
        }
      }
    },
