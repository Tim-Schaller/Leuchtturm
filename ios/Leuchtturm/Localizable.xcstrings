    "Teile deinen Standort mit den Menschen, die dir wichtig sind. Alles wird auf deinem iPhone verschlüsselt, bevor es dein Gerät verlässt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share your location with the people who matter to you. Everything is encrypted on your iPhone before it leaves your device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte tu ubicación con las personas que te importan. Todo se cifra en tu iPhone antes de salir de tu dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partage ta position avec les personnes qui comptent pour toi. Tout est chiffré sur ton iPhone avant de quitter ton appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condividi la tua posizione con le persone che contano per te. Tutto viene crittografato sul tuo iPhone prima di lasciare il dispositivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deel je locatie met de mensen die belangrijk voor je zijn. Alles wordt op je iPhone versleuteld voordat het je apparaat verlaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udostępniaj swoją lokalizację osobom, które są dla ciebie ważne. Wszystko jest szyfrowane na twoim iPhonie, zanim opuści urządzenie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konumunu senin için önemli olan insanlarla paylaş. Her şey, aygıtından çıkmadan önce iPhone’unda şifrelenir."
          }
        }
      }
    },
