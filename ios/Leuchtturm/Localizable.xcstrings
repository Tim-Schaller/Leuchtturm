          "stringUnit": {
            "state": "translated",
            "value": "Invite link"
          }
        }
      }
    },
    "Einstellungen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings"
          }
        }
      }
    },
    "Ende-zu-Ende-verschlüsselt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End-to-end encrypted"
          }
        }
      }
    },
    "Ende-zu-Ende-verschlüsselt · Schlüsselversion %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End-to-end encrypted · key version %lld"
          }
        }
      }
    },
    "Ende-zu-Ende-verschlüsselt. Alle im Leuchtturm können es lesen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End-to-end encrypted. Everyone in the lighthouse can read it."
          }
        }
      }
    },
    "Ende-zu-Ende-verschlüsselt. Wie lange der Verlauf aufbewahrt wird, legt %@ selbst fest.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End-to-end encrypted. How long the history is kept is up to %@."
          }
        }
      }
    },
    "Entdecker: über 10 km unterwegs": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explorer: more than 10 km on the way"
          }
        }
      }
    },
    "Entfernen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove"
          }
        }
      }
    },
    "Entfernt die Fahrt für alle, sie zählt dann nicht für deine Punkte.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes the trip for everyone; it no longer counts for your score."
          }
        }
      }
    },
    "Entfernung": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Distance"
          }
        }
      }
    },
    "Entwarnung senden": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send all-clear"
          }
        }
      }
    },
    "Entwicklung": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Development"
          }
        }
      }
    },
    "Erkannt auf dem iPhone von %@. Ende-zu-Ende-verschlüsselt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detected on %@'s iPhone. End-to-end encrypted."
          }
        }
      }
    },
    "Erstellen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create"
          }
        }
      }
    },
    "Es sah nach einem Unfall aus. In %lld Sekunden alarmiert die App deine Leuchttürme.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It looked like a crash. The app alerts your lighthouses in %lld seconds."
          }
        }
      }
    },
    "Es sah nach einem Unfall aus. Ohne Antwort alarmiert die App in 60 Sekunden deine Leuchttürme.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It looked like a crash. Without an answer, the app alerts your lighthouses in 60 seconds."
          }
        }
      }
    },
    "Fahrten": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trips"
          }
        }
      }
    },
    "Fahrten teilen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share trips"
          }
        }
      }
    },
    "Fertig": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        }
      }
    },
    "Fremder öffnet den iCloud-Link": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stranger opens the iCloud link"
          }
        }
      }
    },
    "Fährt · %@ · %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Driving · %@ · %@"
          }
        }
      }
    },
    "Genauigkeit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accuracy"
          }
        }
      }
    },
    "Gerade eben": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just now"
          }
        }
      }
    },
    "Gerade niemand da": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody here right now"
          }
        }
      }
    },
    "Gespeichert wird in deiner iCloud. Apple sieht nur verschlüsselte Daten, aber welche iCloud-Konten gemeinsam in einem Leuchtturm sind. Alle Mitglieder brauchen ein iCloud-Konto.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data is stored in your iCloud. Apple sees only encrypted data, but also which iCloud accounts share a lighthouse. All members need an iCloud account."
          }
        }
      }
    },
    "Gestern": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yesterday"
          }
        }
      }
    },
    "Gib zuerst deinen Namen ein, dann geht es hier los.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your name first, then you can start here."
          }
        }
      }
    },
    "Groß": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Large"
          }
        }
      }
    },
    "Größe": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Size"
          }
        }
      }
    },
    "Gründe einen Leuchtturm für deine Familie oder Freunde, oder tritt über eine Einladung bei.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a lighthouse for your family or friends, or join with an invite."
          }
        }
      }
    },
    "Guten-Morgen-Gruß": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good-morning greeting"
          }
        }
      }
    },
    "Gültig für": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Valid for"
          }
        }
      }
    },
    "Halte den Knopf 3 Sekunden gedrückt. Alle deine Leuchttürme bekommen eine dringende Nachricht mit deinem genauen Ort, auch im Nebel.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the button for 3 seconds. All your lighthouses get an urgent message with your exact location, even in fog."
          }
        }
      }
    },
    "Heute": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today"
          }
        }
      }
    },
    "Hilfe rufen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call for help"
          }
        }
      }
    },
    "Hoppla": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Oops"
          }
        }
      }
    },
    "Höchsttempo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Top speed"
          }
        }
      }
    },
    "Ich bin nur mitgefahren": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I was only a passenger"
          }
        }
      }
    },
    "Im Nebel teilst du keinen genauen Ort. Beende den Nebel zuerst, um einzuchecken.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In fog you don't share an exact location. End the fog first to check in."
          }
        }
      }
    },
    "In Apple Karten öffnen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open in Apple Maps"
          }
        }
      }
    },
    "Jeder mit dem Link kann beitreten, bis er abläuft. Neue Mitglieder siehst du in der Mitgliederliste und kannst sie jederzeit entfernen. Entfernst du jemanden, werden alle offenen Einladungen ungültig.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone with the link can join until it expires. You see new members in the member list and can remove them at any time. Removing someone makes all open invites invalid."
          }
        }
      }
    },
    "Jemand": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone"
          }
        }
      }
    },
    "Jemanden einladen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite someone"
          }
        }
      }
    },
    "Kein Verlauf": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No history"
          }
        }
      }
    },
    "Keine Verbindung zu iCloud. Bitte versuch es gleich noch einmal.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No connection to iCloud. Please try again in a moment."
          }
        }
      }
    },
    "Klein": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Small"
          }
        }
      }
    },
    "Komm in meinen Leuchtturm %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join my lighthouse %@"
          }
        }
      }
    },
    "Kommt jemand an oder geht, bekommt der Leuchtturm Bescheid. Das prüft jedes iPhone selbst, kein Server kennt eure Orte. Vorschläge entstehen aus deinen Aufenthalten, die nur auf diesem iPhone gespeichert sind.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When someone arrives or leaves, the lighthouse is told. Each iPhone checks this itself; no server knows your places. Suggestions come from your stays, which are stored only on this iPhone."
          }
        }
      }
    },
    "Lege zuerst einen Ort an, z. B. die Schule.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a place first, e.g. the school."
          }
        }
      }
    },
    "Leuchtturm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lighthouse"
          }
        }
      }
    },
    "Leuchtturm auf Zeit · endet %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporary lighthouse · ends %@"
          }
        }
      }
    },
    "Leuchtturm beitreten": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join lighthouse"
          }
        }
      }
    },
    "Leuchtturm für alle löschen?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete lighthouse for everyone?"
          }
        }
      }
    },
    "Leuchtturm gründen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a lighthouse"
          }
        }
      }
    },
    "Leuchtturm ist kein Notrufdienst. In Lebensgefahr ruf direkt die 112 an.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leuchtturm is not an emergency service. If a life is in danger, call 112 directly."
          }
        }
      }
    },
    "Leuchtturm löschen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete lighthouse"
          }
        }
      }
    },
    "Leuchtturm speichert in iCloud (Apple). Namen von Leuchttürmen und Personen sowie Standorte werden vorher auf dem iPhone verschlüsselt, Apple kann sie nicht lesen. Apple sieht aber, welche iCloud-Konten zusammen in einem Leuchtturm sind und wann Daten geschrieben werden. Die Daten liegen in Apples Rechenzentren, nicht zwingend in der EU. Die Karte selbst kommt von Apple Karten: Beim Laden sieht Apple, welchen Kartenausschnitt du ansiehst, aber nicht, wer wo ist.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leuchtturm stores data in iCloud (Apple). Names of lighthouses and people and locations are encrypted on the iPhone first; Apple cannot read them. Apple does see which iCloud accounts are in a lighthouse together and when data is written. The data is in Apple's data centers, not necessarily in the EU. The map itself comes from Apple Maps: when it loads, Apple sees which map area you look at, but not who is where."
          }
        }
      }
    },
    "Leuchtturm umbenennen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rename lighthouse"
          }
        }
      }
    },
    "Leuchtturm verlassen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave lighthouse"
          }
        }
      }
    },
    "Leuchtturm verlassen?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave lighthouse?"
          }
        }
      }
    },
    "Leuchtturm verwalten": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage lighthouse"
          }
        }
      }
    },
    "Leuchtturm wählen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose lighthouse"
          }
        }
      }
    },
    "Leuchtturm-Verlauf.gpx": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leuchtturm-History.gpx"
          }
        }
      }
    },
    "Link teilen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share link"
          }
        }
      }
    },
    "Los geht's": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let's go"
          }
        }
      }
    },
    "Löschen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete"
          }
        }
      }
    },
    "Löschen entfernt deine eigenen Leuchttürme für alle, verlässt alle anderen und löscht deine Schlüssel. Das lässt sich nicht rückgängig machen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting removes your own lighthouses for everyone, leaves all others and deletes your keys. This cannot be undone."
          }
        }
      }
    },
    "Löscht die Schlüssel auf diesem iPhone. Deine Leuchttürme in iCloud bleiben bestehen, du kannst sie danach aber nicht mehr lesen und brauchst neue Einladungen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes the keys on this iPhone. Your lighthouses in iCloud remain, but you can no longer read them and need new invites."
          }
        }
      }
    },
    "Markierung entfernen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove mark"
          }
        }
      }
    },
    "Mein Leuchtturm-Verlauf": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My Leuchtturm history"
          }
        }
      }
    },
    "Melden, wenn nicht angekommen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell me if not arrived"
          }
        }
      }
    },
    "Mir geht's gut": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm OK"
          }
        }
      }
    },
    "Mitglied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Member"
          }
        }
      }
    },
    "Mitglieder (%lld)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Members (%lld)"
          }
        }
      }
    },
    "Mittel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Medium"
          }
        }
      }
    },
    "Möglicher Unfall erkannt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Possible crash detected"
          }
        }
      }
    },
    "Nach dem Beitritt sehen die Mitglieder deinen Namen und deinen Standort, Ende-zu-Ende-verschlüsselt. Das Teilen kannst du in den Einstellungen jederzeit pausieren.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After joining, members see your name and location, end-to-end encrypted. You can pause sharing in Settings at any time."
          }
        }
      }
    },
    "Nachrichten": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages"
          }
        }
      }
    },
    "Name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name"
          }
        }
      }
    },
    "Name speichern": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save name"
          }
        }
      }
    },
    "Name, z. B. Zuhause": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name, e.g. Home"
          }
        }
      }
    },
    "Namen müssen 1 bis %lld Zeichen lang sein.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Names must be 1 to %lld characters long."
          }
        }
      }
    },
    "Nebel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fog"
          }
        }
