    "Alle erfundenen Personen sind schon im Leuchtturm.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All made-up people are already in the lighthouse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las personas ficticias ya están en el faro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les personnes fictives sont déjà dans le phare."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le persone inventate sono già nel faro."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle verzonnen personen zitten al in de vuurtoren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie zmyślone osoby są już w latarni."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm hayali kişiler zaten fenerde."
          }
        }
      }
    },
    "Alle gespeicherten Tage als GPX-Datei, z. B. für Karten- und Sport-Apps. Die Datei ist nicht verschlüsselt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All stored days as a GPX file, e.g. for map and sports apps. The file is not encrypted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los días guardados como archivo GPX, p. ej., para apps de mapas y deporte. El archivo no está cifrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les jours enregistrés dans un fichier GPX, par ex. pour des apps de cartes ou de sport. Le fichier n'est pas chiffré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i giorni salvati come file GPX, ad es. per app di mappe e sport. Il file non è crittografato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle bewaarde dagen als GPX-bestand, bijv. voor kaart- en sportapps. Het bestand is niet versleuteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie zapisane dni jako plik GPX, np. do aplikacji z mapami i sportowych. Plik nie jest zaszyfrowany."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı tüm günler GPX dosyası olarak, ör. harita ve spor uygulamaları için. Dosya şifreli değildir."
          }
        }
      }
    },
