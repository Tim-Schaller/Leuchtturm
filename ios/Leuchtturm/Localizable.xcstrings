        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Resim"
          }
        }
      }
    },
    "Bild, Pin und Status sehen alle in deinen Leuchttürmen, Ende-zu-Ende-verschlüsselt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everyone in your lighthouses sees your picture, pin and status, end-to-end encrypted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los de tus faros ven tu imagen, chincheta y estado, con cifrado de extremo a extremo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout le monde dans tes phares voit ta photo, ton épingle et ton statut, chiffrés de bout en bout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Immagine, pin e stato sono visibili a tutti nei tuoi fari, con crittografia end-to-end."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iedereen in je vuurtorens ziet je foto, pin en status, end-to-end versleuteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcie, pinezkę i status widzą wszyscy w twoich latarniach, z szyfrowaniem end-to-end."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Resmini, raptiyeni ve durumunu fenerlerindeki herkes uçtan uca şifreli olarak görür."
          }
        }
      }
    },
    "Bin auf dem Weg": {
      "localizations": {
