    "Max ist in keinem Leuchtturm. Füge ihn mit seinem Code im Freunde-Menü hinzu; er nimmt sofort an.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Max is in no lighthouse. Add him with his code in the friends menu; he accepts right away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Max no está en ningún faro. Añádelo con su código en el menú de amigos; acepta enseguida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Max n'est dans aucun phare. Ajoute-le avec son code dans le menu Amis ; il accepte tout de suite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Max non è in nessun faro. Aggiungilo con il suo codice nel menu amici; accetta subito."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Max zit in geen vuurtoren. Voeg hem toe met zijn code in het vriendenmenu; hij accepteert meteen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Max nie jest w żadnej latarni. Dodaj go jego kodem w menu znajomych; od razu akceptuje."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Max hiçbir fenerde değil. Onu arkadaş menüsünde koduyla ekle; hemen kabul eder."
          }
        }
      }
    },
