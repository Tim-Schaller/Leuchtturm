    "Es sah nach einem Unfall aus. In %lld Sekunden alarmiert die App deine Leuchttürme.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It looked like a crash. The app alerts your lighthouses in %lld seconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parecía un accidente. En %lld segundos, la app alertará a tus faros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On aurait dit un accident. Dans %lld secondes, l'app alerte tes phares."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembrava un incidente. Tra %lld secondi l'app allerta i tuoi fari."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het leek op een ongeval. Over %lld seconden alarmeert de app je vuurtorens."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyglądało to na wypadek. Za %lld s aplikacja zaalarmuje twoje latarnie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaza gibi görünüyordu. Uygulama %lld saniye içinde fenerlerini uyaracak."
          }
        }
      }
    },
    "Es sah nach einem Unfall aus. Ohne Antwort alarmiert die App in 60 Sekunden deine Leuchttürme.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It looked like a crash. Without an answer, the app alerts your lighthouses in 60 seconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parecía un accidente. Si no respondes, la app alertará a tus faros en 60 segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On aurait dit un accident. Sans réponse, l'app alerte tes phares dans 60 secondes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembrava un incidente. Senza risposta, l'app allerta i tuoi fari tra 60 secondi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het leek op een ongeval. Zonder antwoord alarmeert de app over 60 seconden je vuurtorens."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyglądało to na wypadek. Bez odpowiedzi aplikacja zaalarmuje twoje latarnie za 60 sekund."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaza gibi görünüyordu. Yanıt gelmezse uygulama 60 saniye içinde fenerlerini uyarır."
          }
        }
      }
    },
    "Es teilen noch zu wenige ihren Standort.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too few people share their location yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía comparten su ubicación muy pocas personas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop peu de personnes partagent leur position pour l'instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora troppo poche persone condividono la posizione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog te weinig mensen delen hun locatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeszcze za mało osób udostępnia lokalizację."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz çok az kişi konumunu paylaşıyor."
          }
        }
      }
    },
