    "Farben nach Tempo: grün zu Fuß, gelb in der Stadt, orange auf der Landstraße, rot auf der Autobahn, lila über 200 km/h": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Colours by speed: green on foot, yellow in town, orange on country roads, red on the motorway, purple above 200 km/h"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Colores según la velocidad: verde a pie, amarillo en ciudad, naranja en carretera, rojo en autopista, morado por encima de 200 km/h"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couleurs selon la vitesse : vert à pied, jaune en ville, orange sur route, rouge sur autoroute, violet au-delà de 200 km/h"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Colori in base alla velocità: verde a piedi, giallo in città, arancione su strade extraurbane, rosso in autostrada, viola oltre 200 km/h"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleuren per snelheid: groen te voet, geel in de stad, oranje op de provinciale weg, rood op de snelweg, paars boven 200 km/h"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolory według prędkości: zielony pieszo, żółty w mieście, pomarańczowy poza miastem, czerwony na autostradzie, fioletowy powyżej 200 km/h"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hıza göre renkler: yürürken yeşil, şehirde sarı, şehirlerarası yolda turuncu, otoyolda kırmızı, 200 km/h üstünde mor"
          }
        }
      }
    },
