    "%@ löscht den Leuchtturm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ deletes the lighthouse"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ elimina el faro"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ supprime le phare"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ elimina il faro"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verwijdert de vuurtoren"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ usuwa latarnię"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ feneri siliyor"
          }
        }
      }
    },
    "%@ möchte dir den Leuchtturm übergeben.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wants to hand the lighthouse over to you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ quiere cederte el faro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ veut te transférer le phare."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vuole cederti il faro."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wil de vuurtoren aan jou overdragen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ chce przekazać ci latarnię."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ feneri sana devretmek istiyor."
          }
        }
      }
    },
    "%@ möchte mit dir befreundet sein.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wants to be friends with you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ quiere ser tu amigo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ veut être ton ami·e."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vuole essere tuo amico."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wil vrienden met je worden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ chce zostać twoim znajomym."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ seninle arkadaş olmak istiyor."
          }
        }
      }
    },
    "%@ teilt keine Fahrten.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ doesn't share trips."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no comparte trayectos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne partage pas ses trajets."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non condivide i tragitti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ deelt geen ritten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nie udostępnia przejazdów."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sürüş paylaşmıyor."
          }
        }
      }
    },
    "%@ teilt keinen Verlauf.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ does not share their history."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no comparte su historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne partage pas d'historique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non condivide la cronologia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ deelt geen geschiedenis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nie udostępnia historii."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ geçmişini paylaşmıyor."
          }
        }
      }
    },
    "%@ unterwegs · nur auf diesem iPhone gespeichert": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on the way · stored on this iPhone only"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ recorridos · solo guardado en este iPhone"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ parcourus · enregistré uniquement sur cet iPhone"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ percorsi · salvato solo su questo iPhone"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ onderweg · alleen op deze iPhone bewaard"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ w drodze · zapisane tylko na tym iPhonie"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ yol · yalnızca bu iPhone’da saklanır"
          }
        }
      }
    },
    "%@ verlässt den Leuchtturm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ leaves the lighthouse"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sale del faro"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ quitte le phare"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lascia il faro"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verlaat de vuurtoren"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ opuszcza latarnię"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fenerden ayrılıyor"
          }
        }
      }
    },
    "%@ war seit drei Tagen nicht aktiv.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has not been active for three days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lleva tres días sin actividad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune activité de %@ depuis trois jours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna attività di %@ da tre giorni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is al drie dagen niet actief geweest."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: brak aktywności od trzech dni."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ üç gündür etkin değil."
          }
        }
      }
    },
    "%@ wird Admin und kann den Leuchtturm übernehmen. Dann ziehen alle in einen neuen Leuchtturm um, den sie besitzt; du bleibst Admin.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ becomes an admin and can take the lighthouse over. Then everyone moves to a new lighthouse they own; you stay an admin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pasa a ser admin y puede hacerse cargo del faro. Entonces todos se mudan a un faro nuevo de su propiedad; tú sigues siendo admin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ devient admin et peut reprendre le phare. Tout le monde passe alors dans un nouveau phare dont cette personne est propriétaire ; tu restes admin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ diventa admin e può prendere il controllo del faro. Allora tutti si trasferiscono in un nuovo faro di sua proprietà; tu resti admin."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wordt beheerder en kan de vuurtoren overnemen. Dan verhuist iedereen naar een nieuwe vuurtoren met die persoon als eigenaar; jij blijft beheerder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zostaje adminem i może przejąć latarnię. Wtedy wszyscy przenoszą się do nowej latarni, której właścicielem jest ta osoba; ty pozostajesz adminem."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ yönetici olur ve feneri devralabilir. O zaman herkes onun sahibi olduğu yeni bir fenere taşınır; sen yönetici kalırsın."
          }
        }
      }
    },
