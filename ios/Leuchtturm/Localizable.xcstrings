            "state": "translated",
            "value": "Cedi"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Draag over"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przekaż"
          }
        },
        "tr": {
          "stringUnit": {
