            "state": "translated",
            "value": "Resetuj tylko to urządzenie"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bu aygıtı sıfırla"
          }
        }
      }
    },
    "Nur dieses Gerät zurücksetzen?": {
      "localizations": {
        "en": {
