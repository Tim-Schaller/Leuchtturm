    "Bis %@ gab es keine Ankunft bei „%@“.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No arrival at “%2$@” by %1$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta las %@ no hubo ninguna llegada a «%@»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune arrivée à « %2$@ » avant %1$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun arrivo a “%2$@” entro le %1$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om %@ was er nog geen aankomst bij ‘%@’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do %@ brak przybycia na miejsce „%@”."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ saatine kadar “%@” konumuna varış olmadı."
          }
        }
      }
    },
    "Bis ich es ändere": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Until I change it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta que lo cambie"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu'à ce que je le change"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finché non lo cambio"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot ik het wijzig"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopóki tego nie zmienię"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ben değiştirene kadar"
          }
        }
      }
    },
    "Bist du bis dahin nicht angekommen, bekommt dein Leuchtturm einen Hinweis. Kommst du an, endet die Begleitung von selbst.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you have not arrived by then, your lighthouse gets an alert. When you arrive, the escort ends by itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no has llegado para entonces, tu faro recibe un aviso. Cuando llegas, el acompañamiento termina solo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans arrivée de ta part d'ici là, ton phare reçoit une alerte. Dès ton arrivée, l'accompagnement se termine tout seul."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se entro quell'ora non hai raggiunto la destinazione, il tuo faro riceve un avviso. Quando arrivi, l'accompagnamento finisce da solo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ben je dan nog niet aangekomen, dan krijgt je vuurtoren een melding. Kom je aan, dan stopt de begeleiding vanzelf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli do tego czasu nie dotrzesz, twoja latarnia dostanie powiadomienie. Gdy dotrzesz, towarzyszenie zakończy się samo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "O saate kadar varmazsan fenerin bir uyarı alır. Varınca eşlik kendiliğinden biter."
          }
        }
      }
    },
    "Bitte gib dem Ort einen Namen mit höchstens %lld Zeichen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please give the place a name of at most %lld characters."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponle al lugar un nombre de %lld caracteres como máximo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donne au lieu un nom de %lld caractères maximum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dai al luogo un nome di massimo %lld caratteri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef de plek een naam van maximaal %lld tekens."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwa miejsca może mieć do %lld znaków."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lütfen yere en fazla %lld karakterlik bir ad ver."
          }
        }
      }
    },
    "Bitte gib einen Namen mit höchstens %lld Zeichen ein.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please enter a name of at most %lld characters."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce un nombre de %lld caracteres como máximo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisis un nom de %lld caractères maximum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci un nome di massimo %lld caratteri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer een naam in van maximaal %lld tekens."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj nazwę o długości do %lld znaków."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lütfen en fazla %lld karakterlik bir ad gir."
          }
        }
      }
    },
    "Bitte melde dich in den Einstellungen bei iCloud an. Leuchtturm speichert seine verschlüsselten Daten in deiner iCloud.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please sign in to iCloud in Settings. Leuchtturm stores its encrypted data in your iCloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en iCloud en Ajustes. Leuchtturm guarda sus datos cifrados en tu iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecte-toi à iCloud dans Réglages. Leuchtturm stocke ses données chiffrées dans ton iCloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi a iCloud nelle Impostazioni. Leuchtturm salva i suoi dati crittografati nel tuo iCloud."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log in Instellingen in bij iCloud. Leuchtturm bewaart zijn versleutelde gegevens in je iCloud."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się do iCloud w Ustawieniach. Leuchtturm przechowuje swoje zaszyfrowane dane w twoim iCloud."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lütfen Ayarlar’da iCloud’a giriş yap. Leuchtturm şifreli verilerini senin iCloud’unda saklar."
          }
        }
      }
    },
