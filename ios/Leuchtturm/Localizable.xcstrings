    "Gründe einen Leuchtturm für deine Familie oder Freunde, oder tritt über eine Einladung bei.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a lighthouse for your family or friends, or join with an invite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un faro para tu familia o tus amigos, o únete con una invitación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée un phare pour ta famille ou tes amis, ou rejoins-en un avec une invitation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un faro per la tua famiglia o i tuoi amici, oppure unisciti con un invito."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start een vuurtoren voor je familie of vrienden, of word lid via een uitnodiging."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
