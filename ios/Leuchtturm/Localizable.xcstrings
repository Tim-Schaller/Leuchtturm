    "Admins können Leute einladen, Entfernen und Umbenennen beantragen und den Leuchtturm übernehmen, wenn du drei Tage nicht aktiv warst.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Admins can invite people, request removals and renames, and take the lighthouse over if you have not been active for three days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los admins pueden invitar a gente, solicitar que se quite a alguien o se cambie el nombre, y hacerse cargo del faro si llevas tres días sin actividad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les admins peuvent inviter des personnes, demander des retraits et des changements de nom, et reprendre le phare après trois jours sans activité de ta part."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli admin possono invitare persone, richiedere rimozioni e cambi di nome e prendere il controllo del faro dopo tre giorni di inattività da parte tua."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beheerders kunnen mensen uitnodigen, verwijderingen en naamswijzigingen aanvragen en de vuurtoren overnemen als jij drie dagen niet actief bent geweest."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Admini mogą zapraszać osoby, prosić o usunięcie i zmianę nazwy oraz przejąć latarnię po trzech dniach twojej nieaktywności."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yöneticiler kişileri davet edebilir, çıkarma ve yeniden adlandırma talep edebilir ve sen üç gün etkin olmazsan feneri devralabilir."
          }
        }
      }
    },
