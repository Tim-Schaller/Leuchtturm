    "Warte auf den Schlüssel vom Besitzer. Er wird übertragen, sobald der Besitzer die App öffnet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for the key from the owner. It is sent as soon as the owner opens the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando la clave del propietario. Se enviará en cuanto el propietario abra la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente de la clé du propriétaire. Elle sera transmise dès que le propriétaire ouvrira l'app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In attesa della chiave dal proprietario. Verrà trasferita non appena il proprietario apre l'app."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wacht op de sleutel van de eigenaar. Die wordt verstuurd zodra de eigenaar de app opent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oczekiwanie na klucz od właściciela. Zostanie przesłany, gdy właściciel otworzy aplikację."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahipten anahtar bekleniyor. Sahip uygulamayı açar açmaz aktarılır."
          }
        }
      }
    },
