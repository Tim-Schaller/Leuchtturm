    "Leuchtturm ist kein Notrufdienst. In Lebensgefahr ruf direkt die 112 an.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leuchtturm is not an emergency service. If a life is in danger, call 112 directly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leuchtturm no es un servicio de emergencias. Si hay peligro para la vida, llama directamente al 112."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Leuchtturm n'est pas un service d'urgence. En cas de danger de mort, appelle directement le 112."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leuchtturm non è un servizio di emergenza. Se una vita è in pericolo, chiama direttamente il 112."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leuchtturm is geen noodhulpdienst. Bij levensgevaar bel je meteen 112."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leuchtturm nie jest usługą alarmową. W razie zagrożenia życia dzwoń bezpośrednio pod 112."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Leuchtturm bir acil çağrı hizmeti değildir. Hayati tehlikede doğrudan 112’yi ara."
          }
        }
      }
    },
