      }
    },
    "%lld Fahrten · %@ · %lld× stark gebremst": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld trips · %@ · %lld× hard braking"
          }
        }
      }
    },
    "%lld Tage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld days"
          }
        }
      }
    },
    "%lld von 100 Punkten": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld of 100 points"
          }
        }
      }
