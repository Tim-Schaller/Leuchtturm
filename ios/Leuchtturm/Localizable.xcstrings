    "Ende-zu-Ende-verschlüsselt. Alle im Leuchtturm können es lesen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End-to-end encrypted. Everyone in the lighthouse can read it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con cifrado de extremo a extremo. Todos los del faro pueden leerlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiffré de bout en bout. Tout le monde dans le phare peut le lire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crittografia end-to-end. Tutti nel faro possono leggerlo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "End-to-end versleuteld. Iedereen in de vuurtoren kan het lezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szyfrowanie end-to-end. Wszyscy w latarni mogą to przeczytać."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uçtan uca şifreli. Fenerdeki herkes okuyabilir."
          }
        }
      }
    },
    "Ende-zu-Ende-verschlüsselt. Wie lange der Verlauf aufbewahrt wird, legt %@ selbst fest.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End-to-end encrypted. How long the history is kept is up to %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con cifrado de extremo a extremo. %@ decide cuánto tiempo se conserva el historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiffré de bout en bout. %@ décide de la durée de conservation de l'historique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crittografia end-to-end. Per quanto tempo viene conservata la cronologia lo decide %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "End-to-end versleuteld. Hoelang de geschiedenis wordt bewaard, bepaalt %@ zelf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szyfrowanie end-to-end. O tym, jak długo historia jest przechowywana, decyduje %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uçtan uca şifreli. Geçmişin ne kadar saklanacağına %@ kendisi karar verir."
          }
        }
      }
    },
    "Entdecker: über 10 km unterwegs": {
      "localizations": {
