            "state": "translated",
            "value": "Bel 112"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadzwoń pod 112"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "112’yi ara"
          }
        }
      }
    },
    "Nur auf deinem iPhone gespeichert. Kommt die Meldung über die Ankunft zu spät an, kann der Hinweis auch einmal zu Unrecht kommen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored only on your iPhone. If the arrival message arrives late, the alert may occasionally come although they arrived."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se guarda en tu iPhone. Si el aviso de llegada se retrasa, puede que alguna vez la alerta salte sin motivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré uniquement sur ton iPhone. Si le message d'arrivée arrive en retard, l'alerte peut parfois se déclencher à tort."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvato solo sul tuo iPhone. Se la notifica dell'arrivo giunge in ritardo, l'avviso può a volte scattare per errore."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen op je iPhone bewaard. Komt de aankomstmelding te laat binnen, dan kan de waarschuwing ook eens ten onrechte komen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisane tylko na twoim iPhonie. Jeśli informacja o przybyciu dotrze z opóźnieniem, powiadomienie może czasem pojawić się niesłusznie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca iPhone’unda saklanır. Varış bildirimi geç ulaşırsa uyarı nadiren haksız yere de gelebilir."
          }
        }
      }
    },
    "Nur auf diesem iPhone. Schalte „Fahrten teilen“ ein, damit deine Leuchttürme die Summen sehen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only on this iPhone. Turn on “Share Trips” so your lighthouses see the totals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo en este iPhone. Activa «Compartir trayectos» para que tus faros vean los totales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement sur cet iPhone. Active « Partager les trajets » pour que tes phares voient les totaux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo su questo iPhone. Attiva “Condividi tragitti” perché i tuoi fari vedano i totali."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen op deze iPhone. Zet ‘Deel ritten’ aan zodat je vuurtorens de totalen zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko na tym iPhonie. Włącz „Udostępniaj przejazdy”, aby twoje latarnie widziały sumy."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bu iPhone'da. Fenerlerin toplamları görsün diye “Sürüşleri paylaş” seçeneğini aç."
          }
        }
      }
    },
    "Nur dieses Gerät zurücksetzen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset this device only"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restablecer solo este dispositivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réinitialiser cet appareil uniquement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristina solo questo dispositivo"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel alleen dit apparaat opnieuw in"
          }
        },
        "pl": {
