    "Übergeben": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hand over"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceder"
          }
        },
