    "Schalte zuerst „Standort teilen“ ein.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on “Share Location” first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa primero «Compartir ubicación»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active d'abord « Partager la position »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima attiva “Condividi posizione”."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet eerst ‘Deel locatie’ aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw włącz „Udostępniaj lokalizację”."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce “Konumu paylaş” seçeneğini aç."
          }
        }
      }
    },
    "Schalte „Verlauf teilen“ in den Einstellungen ein.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on “Share history” in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa «Compartir historial» en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active « Partager l'historique » dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva “Condividi cronologia” nelle Impostazioni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet ‘Deel geschiedenis’ aan in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz „Udostępniaj historię” w Ustawieniach."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar’da “Geçmişi paylaş” seçeneğini aç."
          }
        }
      }
    },
    "Schickst du jemandem eine Reaktion, antwortet die Person kurz darauf.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you send someone a reaction, they answer shortly after."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le envías una reacción a alguien, esa persona responde poco después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu envoies une réaction à quelqu'un, la personne répond peu après."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se mandi una reazione a qualcuno, questa persona risponde poco dopo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
