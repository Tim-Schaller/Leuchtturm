    "Melde dich in den Einstellungen des Apple TV mit derselben iCloud wie auf deinem iPhone an.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the Apple TV's Settings, sign in with the same iCloud account as on your iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Ajustes del Apple TV, inicia sesión con la misma cuenta de iCloud que en tu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans les Réglages de l'Apple TV, connecte-toi au même compte iCloud que sur ton iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nelle Impostazioni di Apple TV, accedi con lo stesso account iCloud del tuo iPhone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log in Instellingen op de Apple TV in met hetzelfde iCloud-account als op je iPhone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W Ustawieniach Apple TV zaloguj się do tego samego konta iCloud co na iPhonie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV’nin Ayarlar’ında, iPhone’undakiyle aynı iCloud hesabıyla giriş yap."
          }
        }
      }
    },
