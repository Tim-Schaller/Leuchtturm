    "Tippe in Leuchtturm auf „Verbinden“.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Leuchtturm, tap “Connect”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Leuchtturm, toca «Conectar»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Leuchtturm, touche « Connecter »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Leuchtturm, tocca “Collega”."
          }
        },
        "nl": {
