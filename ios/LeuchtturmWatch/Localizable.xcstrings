    "Öffne Leuchtturm auf deinem iPhone. Die Uhr zeigt dann deinen Leuchtturm.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Leuchtturm on your iPhone. Your watch will then show your lighthouse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Leuchtturm en tu iPhone. El reloj mostrará entonces tu faro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Leuchtturm sur ton iPhone. Ta montre affichera alors ton phare."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Leuchtturm sul tuo iPhone. Poi l'orologio mostrerà il tuo faro."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Leuchtturm op je iPhone. Je Apple Watch toont dan je vuurtoren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Leuchtturm na iPhonie. Zegarek pokaże wtedy twoją latarnię."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone’unda Leuchtturm’u aç. Saat o zaman fenerini gösterir."
          }
        }
      }
    }
  },
  "version": "1.0"
