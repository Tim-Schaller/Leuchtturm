    "Das hat nicht geklappt. Ist dein iPhone in der Nähe?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That didn't work. Is your iPhone nearby?"
          }
        }
      }
    },
    "Dein iPhone schickt allen in deinen Leuchttürmen ein SOS mit deinem Ort.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iPhone sends an SOS with your location to everyone in your lighthouses."
          }
        }
      }
    },
