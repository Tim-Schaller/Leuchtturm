    "Das hat nicht geklappt. Ist dein iPhone in der Nähe?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That didn't work. Is your iPhone nearby?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No ha funcionado. ¿Tienes el iPhone cerca?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ça n'a pas marché. Ton iPhone est-il à proximité ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ha funzionato. Il tuo iPhone è vicino?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat is niet gelukt. Is je iPhone in de buurt?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się. Czy twój iPhone jest w pobliżu?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işe yaramadı. iPhone’un yakında mı?"
          }
        }
      }
    },
    "Dein iPhone schickt allen in deinen Leuchttürmen ein SOS mit deinem Ort.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iPhone sends an SOS with your location to everyone in your lighthouses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu iPhone envía un SOS con tu ubicación a todos los de tus faros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton iPhone envoie un SOS avec ta position à tout le monde dans tes phares."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo iPhone invia un SOS con la tua posizione a tutti nei tuoi fari."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je iPhone stuurt iedereen in je vuurtorens een SOS met je locatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój iPhone wyśle wszystkim w twoich latarniach SOS z twoją lokalizacją."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone’un, fenerlerindeki herkese konumunla birlikte bir SOS gönderir."
          }
        }
      }
    },
