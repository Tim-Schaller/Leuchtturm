    "Wer ist wo, mit Akkustand.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who is where, with battery level."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quién está dónde, con nivel de batería."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui est où, avec le niveau de batterie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi è dove, con il livello della batteria."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie is waar, met batterijniveau."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kto gdzie jest, z poziomem baterii."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kim nerede, pil düzeyiyle birlikte."
          }
        }
      }
    },
